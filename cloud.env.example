# AgentOS cloud credentials.
# Copy to .agentos/cloud.env (git-ignored) and fill in. Never commit the real file.
# Check them with:  pnpm agentos cloud check

# --- E2B (cloud sandboxes) ------------------------------------------------
# e2b.dev → Dashboard → API Keys
E2B_API_KEY=

# --- Supabase (hosted database, Auth, Vault) --------------------------------
# Project URL: supabase.com/dashboard/project/<ref>  → the <ref> part
SUPABASE_PROJECT_REF=
# Connect → "Session pooler" connection string (includes your DB password), e.g.
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
# Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Railway (hosting the API, Console and egress proxy) ------------------
# railway.com → Account Settings → Tokens → create an account token
RAILWAY_TOKEN=
